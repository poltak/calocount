{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calocount-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    // llms.txt goes through the Worker so it answers only while the public view is on.
    "run_worker_first": ["/api/*", "/mcp", "/llms.txt"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calocount",
      "database_id": "a8d1973b-03e6-4c71-b9cd-40ecc335e3f8",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "calocount-meals"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Hourly cleanup of meal photos that no meal links to.
  "triggers": {
    "crons": ["0 * * * *"]
  },
  // Only values that are the same for every instance. Each instance sets its
  // own Access values and owner email on its Worker, in the dashboard or as
  // secrets. See docs/deploy-your-own.md.
  "vars": {
    "CALOCOUNT_OWNER_KEY": "default",
    "CALOCOUNT_ALLOW_LOCAL": "false"
  },
  // Keep the variables that the dashboard sets. Without this, each deploy
  // deletes them, and owner sign-in stops.
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
