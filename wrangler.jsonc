{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calocount-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calocount",
      "database_id": "a8d1973b-03e6-4c71-b9cd-40ecc335e3f8",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "calocount-meals"
    }
  ],
  "vars": {
    "CALOCOUNT_OWNER_KEY": "default",
    "CALOCOUNT_ALLOWED_EMAIL": "",
    "CALOCOUNT_ALLOWED_USER_ID": "",
    "CALOCOUNT_ALLOW_LOCAL": "false"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
