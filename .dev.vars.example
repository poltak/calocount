# The Deploy to Cloudflare button asks for each value in this file and saves it
# as a secret of the new Worker. For local development, copy
# .dev.vars.local.example to .dev.vars instead.

# A long phrase that only you know, with at least 12 characters. On your first
# visit, you type it to save your first passkey. Keep it: it also adds a new
# passkey if you lose your devices.
CALOCOUNT_SETUP_CODE=
