# Set this only for local development. Production must use Cloudflare Access.
CALOCOUNT_ALLOW_LOCAL=true
CALOCOUNT_OWNER_KEY=local-owner

# Cloudflare Access values used when CALOCOUNT_ALLOW_LOCAL=false.
CALOCOUNT_ACCESS_TEAM_DOMAIN=
CALOCOUNT_ACCESS_AUDIENCE=

# Preferred production owner email secret. Set it with:
# npx wrangler secret put CALOCOUNT_OWNER_EMAIL
CALOCOUNT_OWNER_EMAIL=

# Legacy fallback for older local or deployed configurations. Do not use this
# name for a new production secret when the dashboard has an existing variable
# binding with the same name.
CALOCOUNT_ALLOWED_EMAIL=
CALOCOUNT_ALLOWED_USER_ID=
