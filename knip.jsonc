{
  "workspaces": {
    ".": {
      "entry": [
        ".agents/hooks/format-edited-files.mjs",
        ".agents/hooks/format-edited-files.test.mjs",
      ],
      "project": [".agents/hooks/**/*.mjs"],
    },
    "backend": {
