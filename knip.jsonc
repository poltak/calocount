{
  "ignore": ["all-in-one-app-boilerplate/**"],
  "workspaces": {
    ".": {
      "entry": [".agents/hooks/format-edited-files.mjs"],
      "project": [".agents/hooks/**/*.mjs"],
    },
    "backend": {
      "entry": [
        "src/features/core/live/index.ts",
        "src/features/core/tests/index.ts",
        "src/server/start.ts",
        "src/features/auth/commands/migrate.ts",
        "src/features/auth/commands/setup-owner.ts",
      ],
    },
    "frontend": {
      "entry": [
        "src/features/core/live/index.ts",
        "src/features/core/tests/index.ts",
        "src/logic/types.ts",
        "src/features/core/logic/use-logic.ts",
      ],
    },
  },
}
