// The type check of the scripts, the agent hooks, and the lint plugins. Node
// runs these files as they are: the pinned Node removes the types, so there is
// no compile step. Node removes only syntax that has no effect at run time, so
// `erasableSyntaxOnly` rejects the rest, such as `enum` and parameter
// properties.
//
// `sync-template.mjs` stays JavaScript. The old sync of a project starts
// itself again at that path after the commit that moved the sync to
// TypeScript, so the file imports `sync-template.ts`.
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["*.ts", "../.agents/hooks/*.ts", "../lint/*.ts"]
}
