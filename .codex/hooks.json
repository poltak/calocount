{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "REPO_ROOT=\"$(git rev-parse --show-toplevel)\" && node \"$REPO_ROOT/.agents/hooks/check-branch-is-current.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "REPO_ROOT=\"$(git rev-parse --show-toplevel)\" && node \"$REPO_ROOT/.agents/hooks/guard-template-owned-files.mjs\" codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "REPO_ROOT=\"$(git rev-parse --show-toplevel)\" && node \"$REPO_ROOT/.agents/hooks/warn-slow-commands.mjs\" codex-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "REPO_ROOT=\"$(git rev-parse --show-toplevel)\" && node \"$REPO_ROOT/.agents/hooks/format-edited-files.mjs\" \"$REPO_ROOT\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "REPO_ROOT=\"$(git rev-parse --show-toplevel)\" && node \"$REPO_ROOT/.agents/hooks/warn-slow-commands.mjs\" codex-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
