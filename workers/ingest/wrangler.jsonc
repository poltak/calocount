{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "calocount-ingest",
  "main": "index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calocount",
      "database_id": "a8d1973b-03e6-4c71-b9cd-40ecc335e3f8",
      "migrations_dir": "../../drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEAL_PHOTOS",
      "bucket_name": "calocount-meals"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
