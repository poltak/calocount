{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "calocount-ingest",
  "main": "index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calocount",
      "database_id": "a8d1973b-03e6-4c71-b9cd-40ecc335e3f8",
      "migrations_dir": "../../drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEAL_PHOTOS",
      "bucket_name": "calocount-meals"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MEAL_QUEUE",
        "queue": "calocount-analysis"
      }
    ],
    "consumers": [
      {
        "queue": "calocount-analysis",
        "max_batch_size": 5,
        "max_retries": 3,
        "max_concurrency": 1
      }
    ]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://calocount-ingest.hoian-embroidery.workers.dev",
    "OWNER_KEY": "default",
    "AI_BACKEND": "openrouter",
    "OPENROUTER_MODEL": "google/gemini-3.7-flash",
    "OPENROUTER_FALLBACK_MODELS": "x-ai/grok-4.6",
    "OPENROUTER_HTTP_REFERER": "https://calocount-app.hoian-embroidery.workers.dev",
    "OPENROUTER_APP_NAME": "Calocount",
    "MAX_RETRY_ATTEMPTS": "3"
  }
}
