{
  "name": "shadow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "check": "pnpm run node-version:check && pnpm --filter backend... run build && pnpm run --no-bail --aggregate-output \"/^check:/\"",
    "check:format": "pnpm run format:check",
    "check:lint": "pnpm run lint",
    "check:types": "pnpm --filter frontend exec tsc -p tsconfig.json",
    "check:build": "pnpm --filter frontend run build",
    "check:test": "pnpm --filter frontend exec vitest run --coverage",
    "check:hooks": "pnpm run test:hooks",
    "check:lint-rules": "pnpm run test:lint-rules",
    "check:unused": "pnpm run unused:check",
    "node-version:check": "node scripts/check-node-version.mjs",
    "build": "pnpm -r --if-present run build",
    "lint": "oxlint --deny-warnings backend frontend common",
    "unused:check": "knip",
    "typecheck": "pnpm --filter @shadow/common build && pnpm -r --if-present run typecheck",
    "test": "pnpm run test:hooks && pnpm run test:lint-rules && pnpm -r --if-present run test",
    "test:hooks": "node --test .agents/hooks/*.test.mjs",
    "test:lint-rules": "node --test lint/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks"
  },
  "description": "",
  "keywords": [],
  "author": "WorldBrain",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "engines": {
    "node": "26.10.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "knip": "6.38.0",
    "lint-staged": "17.6.0",
    "oxlint": "1.85.0",
    "prettier": "3.9.9",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
