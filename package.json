{
  "name": "calocount",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run build && tsx --test tests/*.test.mjs tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.d.ts --ignore-pattern workers/ingest/worker-configuration.d.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply calocount --local",
    "db:seed:local": "tsx scripts/seed-example-meals.ts",
    "db:migrate:remote": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply calocount --remote",
    "types": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types worker-configuration.d.ts",
    "deploy": "pnpm run build && WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy",
    "deploy:dry": "pnpm run build && WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --dry-run",
    "ingest:dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev --config workers/ingest/wrangler.jsonc",
    "ingest:types": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types workers/ingest/worker-configuration.d.ts --config workers/ingest/wrangler.jsonc --env-interface IngestEnv --include-runtime false",
    "ingest:deploy": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --config workers/ingest/wrangler.jsonc",
    "ingest:deploy:dry": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --dry-run --config workers/ingest/wrangler.jsonc"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "^4.125.0"
  },
  "type": "module"
}
