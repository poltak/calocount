{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "playwright.config.ts"
  ],
  // An editor reads the source of these projects, not their build output, so
  // it shows correct types before any build. `tsc` still reads the output.
  "references": [{ "path": "../common" }, { "path": "../backend" }]
}
