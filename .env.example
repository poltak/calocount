# Backend commands load the repository-root .env. Keep real credentials out of Git.
# `pnpm run dev` starts an embedded PostgreSQL on this port when nothing answers
# there. Point this at another database to use that one.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54320/shadow
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate at least 32 random bytes, then paste the result here.
BETTER_AUTH_SECRET=
SHADOW_OWNER_EMAIL=
SHADOW_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
HOST=127.0.0.1
PORT=3000
# Readable log lines for development. Without this, the backend logs JSON.
LOG_FORMAT=pretty
LOG_LEVEL=debug
# Set this only behind a proxy, to the header in which it reports the caller's
# address, such as x-forwarded-for.
SHADOW_CLIENT_ADDRESS_HEADER=
