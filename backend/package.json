{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": {
      "types": "./dist/features/core/server/api.d.ts"
    },
    "./testing": {
      "types": "./dist/features/core/tests/api.d.ts",
      "default": "./dist/features/core/tests/api.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm --filter backend... run build && node ../scripts/dev-database.mjs --migrate -- pnpm run watch",
    "watch": "pnpm run \"/^watch:/\"",
    "watch:common": "pnpm --filter @app/common run dev",
    "watch:build": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "watch:server": "node --watch --watch-preserve-output --env-file-if-exists=../.env dist/features/core/server/start.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../.env dist/features/core/server/start.js",
    "db:migrate": "pnpm --filter backend... run build && node --env-file-if-exists=../.env dist/features/core/scripts/migrate.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@hono/zod-validator": "0.9.1",
    "@app/common": "workspace:*",
    "@simplewebauthn/server": "14.0.3",
    "hono": "4.13.16",
    "kysely": "0.29.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/pg": "8.23.1"
  }
}
