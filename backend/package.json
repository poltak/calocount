{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": {
      "types": "./dist/api.d.ts"
    },
    "./testing": {
      "types": "./dist/features/core/tests/api.d.ts",
      "default": "./dist/features/core/tests/api.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../.env dist/server/start.js",
    "auth:migrate": "pnpm --filter backend... run build && node --env-file-if-exists=../.env dist/features/auth/commands/migrate.js",
    "auth:setup-owner": "pnpm --filter backend... run build && node --env-file-if-exists=../.env dist/features/auth/commands/setup-owner.js",
    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-validator": "0.9.1",
    "@shadow/common": "workspace:*",
    "better-auth": "1.7.6",
    "hono": "4.13.10",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1"
  }
}
