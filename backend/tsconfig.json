{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    // Lets the frontend's coverage report name backend source lines.
    "sourceMap": true,
    "lib": ["ES2022"],
    "types": ["node"],
    // PGlite declarations also name browser and Emscripten types.
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
